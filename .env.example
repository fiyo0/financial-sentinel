# ==============================================================================
# FINANCIAL SENTINEL ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and populate your private keys. DO NOT commit .env!
# ==============================================================================

# Gemini AI Credentials
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.8-flash"


# Telegram Bot Integration (Mobile Access)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_ALLOWED_USERNAMES="your_telegram_handle"
TELEGRAM_ALLOWED_CHAT_IDS=""

# Security & Master Encryption Key (AES-256 Fernet)
APP_SECRET_KEY="your_256_bit_random_hex_key_here"
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_PASSWORD="your_secure_master_passcode"

# Token Budget Constraints
DAILY_TOKEN_LIMIT=500000
MAX_TOKENS_PER_CYCLE=50000

# Optional Webhook Alert Channels
DISCORD_WEBHOOK_URL=""
SLACK_WEBHOOK_URL=""
GENERIC_WEBHOOK_URL=""
